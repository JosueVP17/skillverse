# Puerto del servidor
PORT=5000

# JWT Secret para autenticación
JWT_SECRET=tu_jwt_secret_aqui

# Firebase Admin SDK
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PROJECT_ID=tu-proyecto-id

# Stripe (Modo Test)
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret (Modo Test)
# Obtén tu webhook secret en: https://dashboard.stripe.com/test/webhooks
# Después de crear un endpoint webhook con la URL: http://localhost:5000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL del frontend para redirecciones de Stripe
FRONTEND_URL=http://localhost:5173
